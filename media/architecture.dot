digraph STMD {
    graph [rankdir=LR, bgcolor="#ffffff", pad="0.32", nodesep="0.35", ranksep="0.55", splines=ortho, fontname="DejaVu Sans", fontsize=14, label="PERCH · STMD-inspired small-target detection", labelloc=t, labeljust=l];
    node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#CBD5E1", penwidth=1.3, margin="0.15,0.09", fillcolor="#F8FAFC", fontcolor="#0F172A"];
    edge [color="#64748B", arrowsize=0.72, penwidth=1.4];
    input [label="Indoor video\n320 × 320 luminance", fillcolor="#E2EDF9"];
    flow [label="Global background motion\nphase correlation", fillcolor="#EDF5FF"];
    a [label="Broad STMD-like response\ndark centre + temporal facilitation", fillcolor="#EDF9F1"];
    b [label="Dense-motion inhibited\ncentre–surround evidence", fillcolor="#EDF9F1"];
    c [label="Texture-tolerant pathway\nsurround-normalized response", fillcolor="#EDF9F1"];
    d [label="Local optic-flow residual\nFarneback registration", fillcolor="#FFF3E6"];
    norm [label="Normalize evidence maps\n& select spatial peaks", fillcolor="#F4F0FF"];
    hyp [label="Competing predictions (≤ 9)\nposition · velocity · support", fillcolor="#E9E5FC"];
    confidence [label="Detection + heuristic confidence\nlocation · direction · alternatives", fillcolor="#DDF6F2", color="#0F766E", penwidth=2];
    dvs [label="Simulated DVS-style ON/OFF\ndisplay only", fillcolor="#F1F5F9", style="rounded,dashed,filled"];
    input -> flow;
    flow -> a; flow -> b; flow -> c; flow -> d;
    a -> norm; b -> norm; c -> norm; d -> norm;
    norm -> hyp; hyp -> confidence;
    hyp -> hyp [label="  memory / decay  ", color="#7C3AED", fontcolor="#7C3AED", constraint=false];
    input -> dvs [style=dashed, color="#94A3B8", constraint=false];
    {rank=same; a;b;c;d}
}
